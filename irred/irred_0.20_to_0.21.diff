+    const int tt = omp_get_thread_num(), nt = omp_get_num_threads();
+    if (par_reduce) {
+      long top = (long)q11 - deltaw;
+      while (top >= low) {
+        long n = top - low + 1;
+        if (n > deltaw) n = deltaw;
+        long t0 = top - n + 1;
