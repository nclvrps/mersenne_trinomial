$ cd irred

$ make
cc -O3 -march=native -fopenmp -Wall -Wextra -o build/irred irred/irred.c -lm
cc -O3 -fopenmp -Wall -Wextra -o build/irred_generic irred/irred.c -lm
cc -O1 -g -fopenmp -fsanitize=address,undefined -fno-sanitize-recover=all \
    -fno-omit-frame-pointer -o build/irred_asan irred/irred.c -lm
cc -O2 -o build/ref tools/ref.c
cc -O3 -march=native -fopenmp -Wall -Wextra -DIRRED_GPU -c -o build/irred_gpu.o irred/irred.c
nvcc -O3 -arch=native -Iirred -o build/irred_gpu irred/irred_gpu.cu build/irred_gpu.o \
    -lm -Xcompiler -fopenmp
