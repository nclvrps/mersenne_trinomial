# Trying SIGINT instead also produced no output, and ended the shell loop

$     for nt in "" --nt; do       for n in 1 2 3 4 6; do         echo "threads $n $nt";         timeout -s INT 9
0 ../build/irred --no-ckpt --progress 2000             --threads $n $nt 136279841 12338357 | grep --line-buffered '^iter' | tail -1;       done;     done
threads 1



# Removing "tail -1" worked.
# On this Zen2 computer, --nt did indeed work better than not using it.
# With --nt, there were no gains beyond using 2 threads.

$     for nt in "" --nt; do       for n in 1 2 3 4 6; do         echo "threads $n $nt";         timeout -s TERM 90 ../build/irred --no-ckpt --progress 2000             --threads $n $nt 136279841 12338357 | grep --line-buffered '^iter';       done;     done
