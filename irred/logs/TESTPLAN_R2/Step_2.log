# The test, as written with tail -1, produced no output.
# Perhaps the irred program does not flush buffers when receiving a SIGTERM.
# Or possibly it might be because I'm using Ubuntu 26.04,
# which reimplemented the coreutils in Rust
# and might not be fully compatible.

$     for nt in "" --nt; do       for n in 1 2 3 4 6; do         echo "threads $n $nt";         timeout -s TERM 90 ../build/irred --no-ckpt --progress 2000             --threads $n $nt 136279841 12338357 | grep '^iter' | tail -1;       done;     done
