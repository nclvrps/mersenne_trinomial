######## Step 1

$ cd irred

$ make
mkdir -p build
cc -O3 -march=native -fopenmp -Wall -Wextra -o build/irred irred/irred.c -lm
cc -O3 -fopenmp -Wall -Wextra -o build/irred_generic irred/irred.c -lm
cc -O1 -g -fopenmp -fsanitize=address,undefined -fno-sanitize-recover=all \
    -fno-omit-frame-pointer -o build/irred_asan irred/irred.c -lm
cc -O2 -o build/ref tools/ref.c
cp reference/irred315_orig.c build/irred.c
cd build && patch -s -p0 < ../reference/irred315_compile.patch
sed -i 's/for (n = 2; n LE nm; n++) {\t\/\* n EQ 1/for (n = 2; n LE 1; n++) {\t\/* n EQ 1/' build/irred.c
grep -q 'for (n = 2; n LE 1; n++)' build/irred.c
mv build/irred.c build/irred315.c
cc -O1 -w -o build/irred315 build/irred315.c
cc -O3 -march=native -w -o build/irred020 reference/irred_0.20.c -lm


