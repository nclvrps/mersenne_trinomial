+// EMUL_LAUNCH(kernel, B, T)(args)
+template <class F> struct Launcher {
+    unsigned B, T; F f;
+    template <class... A> void operator()(A&&... a) {
+        gridDim = {B,1,1}; blockDim = {T,1,1};
