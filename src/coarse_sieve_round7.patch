+struct EmulWarp {
+    EmulLane lane[32];
+    int n, cur;
+    void *sched_sp;
+#if !defined(__x86_64__)
+    ucontext_t sched_uc;
+#endif
+    void (*body)(void *); void *ctx;
+    bool active;
