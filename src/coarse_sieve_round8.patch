+                                                   u64 (&vb)[LB], int n, u32 pairm,
+                                                   bool verify, ull *best,
+                                                   Heavy *heavy, unsigned *nheavy,
+                                                   unsigned *overflow, fw *P,
+                                                   unsigned long long *err PT_PARAM) {
