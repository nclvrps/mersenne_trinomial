+// one step of g^u: G = G^2, then G = G * x in the slots selected by sel
+template <int D>
+GF2_HD void bs_step_g(u32 (&G)[D], u32 sel) {
+    u32 R[D];
+    bs_sqr<D>(G, R);
+    GF2D_UNROLL
+    for (int k = 0; k < D; k++) G[k] = R[k];
+    bs_mulx_sel<D>(G, sel);
+}
