     auto exponent_for = [&](u64 P) {
+        if (!search_exponent) return M / P;
         for (auto &e : ecache) if (e.first == P) return e.second;
         u64 E = ph_best_exponent(d, M, P, primes, cm);
         ecache.push_back({P, E});
diff -uN a/randread.cu b/randread.cu
--- a/randread.cu	1969-12-31 19:00:00.000000000 -0500
+++ b/randread.cu	2026-10-29 00:37:48.857446155 -0400
@@ -0,0 +1,173 @@
+// randread.cu (round 9): how many random 8-byte reads per second can this
+// GPU's DRAM serve?  coarse_sieve's RR engine makes two such reads per Zech
+// log (the quadratic tower one), at random places in a table of 64 MB - 2 GB;
+// this measures the ceiling those reads face, alone and beside streaming
+// traffic shaped like the batch arrays' local memory (~70-80% of the DRAM
+// bytes in the round-7 profiles).
+//
+//   nvcc -O3 -arch=native -o randread randread.cu
+//   ./randread [max_table_MB]          (default 2048; well under a minute)
+//
+// Each thread of the random part runs a private xorshift and keeps R
+// independent reads in flight (R = 1, 2, 4, 8 per loop iteration), XOR-ing
+// them into a register stored at the end (so nothing is optimized away).
+// Reads go past L1 (__ldcg), as coarse_sieve's do; a table far larger than
+// L2 makes each one a DRAM access of a 32-byte sector.  In the mixed test,
+// half the blocks instead stream through their own slices of a separate
+// 512 MB buffer, 256 B per warp access (8 B per lane, read then written
+// back: local memory's layout), until the random blocks are done.
+#include <cstdio>
+#include <cstdlib>
+#include <cstdint>
+#include <vector>
+#include <algorithm>
+#include <cuda_runtime.h>
+
+#define CK(x) do { cudaError_t e_ = (x); if (e_ != cudaSuccess) { \
+    fprintf(stderr, "CUDA error %s at line %d\n", cudaGetErrorString(e_), __LINE__); exit(1); } } while (0)
+
+typedef unsigned long long u64;
+
+template <int R>
+__global__ void k_rand(const u64 *__restrict__ tab, u64 mask, int iters,
+                       u64 *out, int sblocks, u64 *sbuf, u64 slice,
+                       unsigned *done, unsigned *passes) {
+    const u64 tid = (u64)blockIdx.x * blockDim.x + threadIdx.x;
+    u64 acc = 0;
+    if ((int)blockIdx.x < sblocks) {            // streaming, until done
+        const u64 warp = tid / 32, lane = tid & 31;
+        u64 *p = sbuf + warp * slice + lane;
+        const unsigned nrand = gridDim.x - sblocks;
+        unsigned np = 0;
+        for (;;) {
+            for (u64 i = 0; i + 32 <= slice; i += 32) {
+                const u64 v = __ldcg(p + i);
+                acc ^= v;
+                p[i] = v + 1;
+            }
+            np++;
+            if (*(volatile unsigned *)done >= nrand || np >= 100000) break;
+        }
+        if (threadIdx.x == 0) passes[blockIdx.x] = np;
+    } else {
+        u64 x = 0x9E3779B97F4A7C15ULL * (tid + 1);
+        for (int it = 0; it < iters; it++) {
+            u64 idx[R], v[R];
+#pragma unroll
+            for (int r = 0; r < R; r++) {
+                x ^= x << 13; x ^= x >> 7; x ^= x << 17;
+                idx[r] = x & mask;
+            }
+#pragma unroll
+            for (int r = 0; r < R; r++) v[r] = __ldcg(tab + idx[r]);
+#pragma unroll
+            for (int r = 0; r < R; r++) acc ^= v[r];
+        }
+        __syncthreads();
+        if (threadIdx.x == 0) { __threadfence(); atomicAdd(done, 1u); }
+    }
+    out[tid] = acc;
+}
+
+struct Ctx { int blocks, threads; u64 *out, *sbuf; u64 swords; unsigned *done, *passes; };
+
+// G random reads/s; with sblocks > 0 also the streaming GB/s beside them
+template <int R>
+static double run(const Ctx &c, const u64 *tab, u64 mask, int iters, int sblocks,
+                  double *sgbs) {
+    const u64 nwarps = (u64)(sblocks ? sblocks : 1) * c.threads / 32;
+    const u64 slice = c.swords / nwarps / 32 * 32;
+    cudaEvent_t a, b;
+    CK(cudaEventCreate(&a)); CK(cudaEventCreate(&b));
+    for (int rep = 0; rep < 2; rep++) {         // warm-up, then timed
+        CK(cudaMemset(c.done, 0, 4));
+        CK(cudaEventRecord(a));
+        k_rand<R><<<c.blocks, c.threads>>>(tab, mask, rep ? iters : 1, c.out, sblocks,
+                                           c.sbuf, slice, c.done, c.passes);
+        CK(cudaEventRecord(b));
+        CK(cudaEventSynchronize(b));
+        CK(cudaGetLastError());
+    }
+    float ms = 0;
+    CK(cudaEventElapsedTime(&ms, a, b));
+    cudaEventDestroy(a); cudaEventDestroy(b);
+    const double s = ms / 1e3;
+    if (sgbs) {
+        std::vector<unsigned> np(c.blocks);
+        CK(cudaMemcpy(np.data(), c.passes, c.blocks * 4, cudaMemcpyDeviceToHost));
+        double bytes = 0;
+        for (int i = 0; i < sblocks; i++)
+            bytes += (double)np[i] * (c.threads / 32) * slice * 8.0 * 2;   // read + write
+        *sgbs = bytes / s / 1e9;
+    }
+    return (double)(c.blocks - sblocks) * c.threads * (double)iters * R / s / 1e9;
+}
+
+int main(int argc, char **argv) {
+    const size_t max_mb = argc > 1 ? strtoull(argv[1], nullptr, 10) : 2048;
+    cudaDeviceProp p;
+    CK(cudaGetDeviceProperties(&p, 0));
+    int clk = 0, mclk = 0, bus = 0;
+    cudaDeviceGetAttribute(&clk, cudaDevAttrClockRate, 0);
+    cudaDeviceGetAttribute(&mclk, cudaDevAttrMemoryClockRate, 0);
+    cudaDeviceGetAttribute(&bus, cudaDevAttrGlobalMemoryBusWidth, 0);
+    printf("%s: %d SMs, %.0f MHz, L2 %d MB, DRAM %d-bit, peak %.0f GB/s\n", p.name,
+           p.multiProcessorCount, clk / 1e3, p.l2CacheSize >> 20, bus,
+           2.0 * mclk * 1e3 * (bus / 8) / 1e9);
+    Ctx c;
+    c.threads = 256;
+    int per = 1;
+    CK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&per, k_rand<8>, c.threads, 0));
+    c.blocks = p.multiProcessorCount * per;     // all resident at once
+    CK(cudaMalloc(&c.out, (size_t)c.blocks * c.threads * sizeof(u64)));
+    CK(cudaMalloc(&c.done, 4));
+    CK(cudaMalloc(&c.passes, c.blocks * 4));
+    c.swords = (u64)64 << 20;                   // 512 MB stream buffer
+    CK(cudaMalloc(&c.sbuf, c.swords * 8));
+    CK(cudaMemset(c.sbuf, 0, c.swords * 8));
+    printf("%d blocks of %d threads (%d per SM)\n", c.blocks, c.threads, per * c.threads);
+    double sga = 0;                             // every block streams, 8 passes
+    {
+        cudaEvent_t a, b;
+        CK(cudaEventCreate(&a)); CK(cudaEventCreate(&b));
+        const u64 slice = c.swords / ((u64)c.blocks * c.threads / 32) / 32 * 32;
+        CK(cudaMemset(c.done, 0xFF, 4));        // "done" at once: one pass each
+        CK(cudaEventRecord(a));
+        for (int i = 0; i < 8; i++)
+            k_rand<1><<<c.blocks, c.threads>>>(c.sbuf, 0, 1, c.out, c.blocks, c.sbuf,
+                                               slice, c.done, c.passes);
+        CK(cudaEventRecord(b));
+        CK(cudaEventSynchronize(b));
+        float ms = 0;
+        CK(cudaEventElapsedTime(&ms, a, b));
+        sga = 8.0 * c.blocks * (c.threads / 32) * slice * 8.0 * 2 / (ms / 1e3) / 1e9;
+        cudaEventDestroy(a); cudaEventDestroy(b);
+    }
+    printf("streaming alone (read + write, 256 B per warp access): %.0f GB/s\n", sga);
+    for (size_t mb = 64; mb <= max_mb; mb *= 4) {
+        size_t freeb = 0, totb = 0;
+        CK(cudaMemGetInfo(&freeb, &totb));
+        if (mb * 1048576 + ((size_t)256 << 20) > freeb) { printf("table %zu MB: no room\n", mb); break; }
+        u64 *tab;
+        const u64 n = (u64)mb * 1048576 / 8;
+        CK(cudaMalloc(&tab, n * 8));
+        CK(cudaMemset(tab, 0x5A, n * 8));
+        const u64 mask = n - 1;
+        const double r1 = run<1>(c, tab, mask, 256, 0, nullptr);
+        const double r2 = run<2>(c, tab, mask, 128, 0, nullptr);
+        const double r4 = run<4>(c, tab, mask, 64, 0, nullptr);
+        const double r8 = run<8>(c, tab, mask, 32, 0, nullptr);
+        printf("table %4zu MB: random 8-byte reads, G/s with 1/2/4/8 in flight per thread: "
+               "%.2f %.2f %.2f %.2f  (= %.0f GB/s of 32-byte sectors at best)\n", mb,
+               r1, r2, r4, r8, 32 * std::max(std::max(r1, r2), std::max(r4, r8)));
+        double sgb = 0;
+        const double rm = run<4>(c, tab, mask, 64, c.blocks / 2, &sgb);
+        printf("               half the blocks streaming instead: random %.2f G/s beside %.0f GB/s "
+               "of streaming\n", rm, sgb);
+        CK(cudaFree(tab));
+    }
+    printf("(coarse_sieve, round 8, 2070 SUPER: RR at d = 45-53 makes ~1.7-1.9 G table reads/s, "
+           "the classic tower at d=46 ~1.8 G/s, the subfield tower at d=44 ~1.3 G/s, beside "
+           "~140-200 GB/s of local-memory traffic)\n");
+    return 0;
+}
diff -uN a/t_cubic.cpp b/t_cubic.cpp
--- a/t_cubic.cpp	1969-12-31 19:00:00.000000000 -0500
+++ b/t_cubic.cpp	2026-10-29 00:37:48.853379669 -0400
@@ -0,0 +1,150 @@
+// t_cubic.cpp: the cubic tower (round 9) against ground truth.
+//   t_cubic [dmax] [samples]
+// For every 6 | d in 12..dmax: build the cubic structure (cubic_build_host),
+// fill T3 by an independent host Pohlig-Hellman (BSGS per prime; lazily, so
+// only the entries the checked x need at large d), and check cubic_log(x) ==
+// log x -- for every x at d <= 18, for `samples` random x = g^u above --
+// and that the sieve's compile-time cubic_parts<d> agrees with the checks'
+// cubic_parts_rt on every one of them.
+// Build: g++ -O2 -march=native -std=c++17 -o t_cubic t_cubic.cpp
+#include "gf2_dlog.h"
+#include <random>
+#include <cstdio>
+#include <chrono>
+#include <unordered_map>
+static std::mt19937_64 rng(11);
+
+// log_g(x) in GF(2^d) (g = x mod q) by Pohlig-Hellman over the prime powers
+// of M, BSGS per prime -- shares nothing with the device code
+struct HostPH {
+    int d; u64 q, M;
+    std::vector<u64> pp, pr;  // prime powers p^e || M, and p
+    std::vector<int> ex;
+    std::vector<std::unordered_map<u64, u32>> baby;   // per prime: gamma^j -> j
+    std::vector<u64> gam, giant, bm;
+    void init(int d_, u64 q_) {
+        d = d_; q = q_; M = ((u64)1 << d) - 1;
+        u64 rest = M;
+        for (u64 p : factor_u64(M)) {
+            int e = 0; u64 pe = 1;
+            while (rest % p == 0) { rest /= p; e++; pe *= p; }
+            pp.push_back(pe); pr.push_back(p); ex.push_back(e);
+            const u64 gp = gf_pow(2, M / p, q, d);          // order p
+            u64 m = 1; while (m * m < p) m++;
+            std::unordered_map<u64, u32> b;
+            u64 t = 1;
+            for (u64 j = 0; j < m; j++) { b.emplace(t, (u32)j); t = gf_mul(t, gp, q, d); }
+            baby.push_back(std::move(b));
+            gam.push_back(gp);
+            giant.push_back(gf_pow(gp, (p - m % p) % p, q, d));  // gp^(-m)
+            bm.push_back(m);
+        }
+    }
+    u64 dlog_p(size_t i, u64 h) {                      // h in <gam[i]>
+        u64 y = h;
+        for (u64 s = 0; s <= bm[i]; s++) {
+            auto it = baby[i].find(y);
+            if (it != baby[i].end()) return (s * bm[i] + it->second) % pr[i];
+            y = gf_mul(y, giant[i], q, d);
+        }
+        return ~0ULL;
+    }
+    u64 log(u64 x) {
+        u64 v = 0;
+        for (size_t i = 0; i < pp.size(); i++) {
+            const u64 pe = pp[i], p = pr[i], m = M / pe;
+            const u64 xp = gf_pow(x, m, q, d), gp = gf_pow(2, m, q, d);   // order p^e
+            u64 l = 0, pk = 1;
+            for (int k = 0; k < ex[i]; k++) {
+                // (xp * gp^-l)^(p^(e-1-k)) = gamma^digit
+                u64 t = gf_mul(xp, gf_pow(gp, (pe - l % pe) % pe, q, d), q, d);
+                u64 pw = 1; for (int z = 0; z < ex[i] - 1 - k; z++) pw *= p;
+                t = gf_pow(t, pw, q, d);
+                const u64 dg = dlog_p(i, t);
+                if (dg == ~0ULL) return ~0ULL;
+                l += dg * pk; pk *= p;
+            }
+            const u64 C = M / pe;                       // CRT
+            v = (v + mulmod_u64(mulmod_u64(C, inv_mod(C % pe, pe), M), l, M)) % M;
+        }
+        return v;
+    }
+};
+
+// the sieve's version (d a template parameter) at run-time d
+static u64 parts_ct(int d, u64 x, const TowerDev &t, u64 *ir, u64 *it) {
+    switch (d) {
+    case 12: return cubic_parts<12>(x, t, ir, it);
+    case 18: return cubic_parts<18>(x, t, ir, it);
+    case 24: return cubic_parts<24>(x, t, ir, it);
+    case 30: return cubic_parts<30>(x, t, ir, it);
+    case 36: return cubic_parts<36>(x, t, ir, it);
+    case 42: return cubic_parts<42>(x, t, ir, it);
+    case 48: return cubic_parts<48>(x, t, ir, it);
+    case 54: return cubic_parts<54>(x, t, ir, it);
+    default: *ir = *it = ~0ULL; return ~0ULL;
+    }
+}
+
+int main(int argc, char **argv) {
+    const int dmax = argc > 1 ? atoi(argv[1]) : 54;
+    const u64 samples = argc > 2 ? strtoull(argv[2], nullptr, 10) : 3000;
+    u64 bad = 0, nchk = 0;
+    for (int d = 12; d <= dmax; d += 6) {
+        auto t0 = std::chrono::steady_clock::now();
+        const u64 q = find_primitive_poly(d), ql = q ^ ((u64)1 << d), M = ((u64)1 << d) - 1;
+        CubicHost C;
+        if (!cubic_build_host(d, q, C)) { printf("d=%d: build FAILED\n", d); bad++; continue; }
+        HostPH ph; ph.init(d, q);
+        // T3, lazily: T3[l] = log(w + y'^l), T3[MK] = log w, T3[MK + 1] = 0
+        std::vector<u64> T3((size_t)C.MK + 2, ~0ULL);
+        T3[C.MK] = C.logw;
+        T3[C.MK + 1] = 0;
+        if (ph.log(C.w) != C.logw) { printf("d=%d: log w mismatch\n", d); bad++; continue; }
+        if (gf_pow(C.kappa, C.c, q, d) != C.yp) { printf("d=%d: y' != kappa^c\n", d); bad++; continue; }
+        auto fill = [&](u64 l) {
+            if (T3[l] != ~0ULL) return;
+            T3[l] = ph.log(C.w ^ gf_pow(C.yp, l, q, d));
+        };
+        const bool full = C.MK <= 4096;
+        if (full) for (u64 l = 0; l < C.MK; l++) fill(l);
+        TowerDev t = cubic_dev(C, C.btab.data(), T3.data(), C.kt.btab.data(),
+                               C.kt.LK.data(), C.kT.data());
+        u64 gp[64]; gp[0] = 2;
+        for (int k = 1; k < d; k++) gp[k] = gf_sqr(gp[k - 1], q, d);
+        const bool exh = d <= 18;
+        const u64 cnt = exh ? M : samples;
+        u64 b = 0, x = 1, nk = 0, bct = 0;
+        for (u64 i = 0; i < cnt; i++) {
+            const u64 u = exh ? i : rng() % M;
+            if (!exh) x = gf2f_antilog(u, ql, d, gp);
+            u64 ir, it, ir2, it2;
+            const u64 lb = cubic_parts_rt(x, t, &ir, &it);
+            nk += ir == C.MK + 1 && it == C.MK + 1;
+            if (!full) { fill(ir); fill(it); }
+            if (cubic_log(x, M, t) != u) b++;
+            if (parts_ct(d, x, t, &ir2, &it2) != lb || ir2 != ir || it2 != it) bct++;
+            if (exh) x = gf_mulx(x, q, d);
+        }
+        // and the elements of K* (x = phi(Y0), the inK branch) on a sample
+        u64 bk = 0;
+        for (int i = 0; i < 200; i++) {
+            const u64 l = rng() % C.MK, u = mulmod_u64(C.H, l, M);
+            const u64 xk = gf2f_antilog(u, ql, d, gp);
+            if (cubic_log(xk, M, t) != u) bk++;
+            u64 ir, it, ir2, it2;
+            if (parts_ct(d, xk, t, &ir2, &it2) != cubic_parts_rt(xk, t, &ir, &it) ||
+                ir2 != ir || it2 != it || ir != C.MK + 1 || it != C.MK + 1) bk++;
+        }
+        nchk += cnt + 200; bad += b + bk + bct;
+        double s = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+        printf("d=%2d n=%2d c=%6llu T3=%7llu: %8llu logs (%s), %llu wrong, %llu with "
+               "cubic_parts<d> != cubic_parts_rt; K* %llu wrong (%.1fs)\n",
+               d, C.n, (unsigned long long)C.c, (unsigned long long)C.MK + 2,
+               (unsigned long long)cnt, exh ? "all" : "sampled", (unsigned long long)b,
+               (unsigned long long)bct, (unsigned long long)bk, s);
+    }
+    printf("%s: %llu logs, %llu wrong\n", bad ? "FAILURES" : "ALL OK",
+           (unsigned long long)nchk, (unsigned long long)bad);
+    return bad != 0;
+}
