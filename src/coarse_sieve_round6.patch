+        if (!checked) {                          // the newest readable one
+            checked = true;
+            why = ckpt_mismatch(c, r, smax, d_lo, d_hi, seed, seed_hash);
+            if (!why.empty()) { fclose(f); gen = g; return -2; }
+        } else if (!ckpt_mismatch(c, r, smax, d_lo, d_hi, seed, seed_hash).empty()) {
