+                const int prole = gf2f_pair_role(pr, d, M);
+                if (role == 1) { n1++; if (prole != 0 || pr == u) bad++; }
+                else if (role == 0) { n0++; if (prole != 1 || pr == u) bad++; }
+                else { n2++; if (pr != u) bad++; }
