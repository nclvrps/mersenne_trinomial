+static void ckpt_set_aside(const char *path) {
+    char g[1100], o[1110];
+    int n = 0;
+    for (int i = 0; i < 8; i++) {
+        if (i == 0) snprintf(g, sizeof g, "%s", path);
+        else        snprintf(g, sizeof g, "%s.%d", path, i);
+        if (access(g, F_OK) != 0) continue;
+        snprintf(o, sizeof o, "%s.old", g);
