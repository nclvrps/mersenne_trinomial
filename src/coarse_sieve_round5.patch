+    for (int i = 0; i < 8; i++) {
+        if (i == 0) snprintf(g, sizeof g, "%s", path);
+        else        snprintf(g, sizeof g, "%s.%d", path, i);
+        if (access(g, F_OK) != 0) { if (i == 0) continue; else break; }
+        any = true;
+        if (ckpt_peek(g, ci)) { gen = g; return 1; }
+    }
