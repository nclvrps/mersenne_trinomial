+    const u64 lo = (mid << 32) | (u32)p00;
+    const u64 hi = p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32);
+#endif
+    const u64 A = (lo >> d) | (hi << (64 - d));     // a*b < 2^(2d): fits
+    const u64 B = lo & M;
+    return A + (A + B >= M ? 1 : 0);
