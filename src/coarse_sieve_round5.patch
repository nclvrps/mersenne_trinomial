+    const u32 n = 1u << (dh + 1);
+    L.assign(n, 0);
+    for (size_t i = 0; i < irr.size(); i++) L[irr[i]] = irr_log[i];
+    L[1] = 0;
+    for (u32 P = 2; P < n; P++) {
+        const u32 f = spf[P];
+        if (!f) continue;                        // irreducible: set above
+        const u64 s = L[f] + L[rr_divexact(P, f)];
+        L[P] = s >= M ? s - M : s;
+    }
