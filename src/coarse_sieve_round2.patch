+// selftest: check log(g^u) == u for u in [0, min(M, 2^24)) on device 0
+static void logs_selfcheck(int d, const LogsParams &L) {
+    GpuCtx &G = g_gpus[0];
+    CUCHK(cudaSetDevice(G.dev));
