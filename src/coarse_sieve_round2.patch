+            double t0 = now_s();
+            CUCHK(cudaMalloc(&G.dgp, d * sizeof(fw)));
+            CUCHK(cudaMemcpy(G.dgp, gpow2, d * sizeof(fw), cudaMemcpyHostToDevice));
