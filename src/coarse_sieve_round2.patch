+// Method override (COARSE_METHOD env var or --selftest-logs):
+enum { FM_AUTO = 0, FM_TOWER = 1, FM_PH = 2, FM_LOGS = 3, FM_BUCKETS = 4,
+       FM_DENSE = 5 };
