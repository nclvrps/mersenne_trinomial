+        const u64 q = find_primitive_poly(d), M = ((u64)1 << d) - 1;
+        fw gpow2[64];
+        gpow2[0] = 2;
+        for (int t = 1; t < d; t++) gpow2[t] = gf_sqr(gpow2[t - 1], q, d);
+        for (int eng : {FM_TOWER, FM_PH}) {
+            if (want != FM_LOGS && want != eng) continue;
+            LogsPlan pl;
