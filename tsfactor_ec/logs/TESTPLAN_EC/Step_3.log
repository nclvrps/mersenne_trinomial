$ make emul-tsfactor && ./build_emul/tsfactor --selftest
== NTL: OK (-lntl -lgf2x -lgmp) ==
mkdir -p build_emul
for h in gf2_cantor_core.h gf2_cantor_engine.h cuda_emul.h gf2_gcd.h gf2_ec.h; do \
  cp $(ls common/$h 2>/dev/null || ls $h) build_emul/; done
sed -E 's/([A-Za-z_][A-Za-z0-9_]*)<<<([^>]*)>>>/EMUL_LAUNCH(\1, \2)/g; s/__device__ __forceinline__/static inline/' $(ls common/gf2_cantor_cuda.h 2>/dev/null || ls gf2_cantor_cuda.h) > build_emul/gf2_cantor_cuda.h
sed -E 's/([A-Za-z_][A-Za-z0-9_]*)<<<([^>]*)>>>/EMUL_LAUNCH(\1, \2)/g; s/__device__ __forceinline__/static inline/' $(ls common/gf2_trinomial_cuda.h 2>/dev/null || ls gf2_trinomial_cuda.h) > build_emul/gf2_trinomial_cuda.h
printf '#pragma once\n#include "cuda_emul.h"\n' > build_emul/cuda_runtime.h
sed -E 's/([A-Za-z_][A-Za-z0-9_]*)<<<([^>]*)>>>/EMUL_LAUNCH(\1, \2)/g; s/__device__ __forceinline__/static inline/' tsfactor.cu > build_emul/tsfactor.cpp
g++ -O2 -march=native -Wall -Wextra -x c++ -Ibuild_emul -DHAVE_NTL -pthread -o build_emul/tsfactor build_emul/tsfactor.cpp build_emul/gf2_gcd_ntl.cpp -lntl -lgf2x -lgmp
